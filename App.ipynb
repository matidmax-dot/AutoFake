      "source": [
        "# 1. Instalar librerías necesarias\n",
        "!pip install -q fastapi uvicorn pandas python-multipart\n",
        "\n",
        "# 2. Descargar cliente Cloudflare Tunnel\n",
        "!wget -q -O cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\n",
        "!chmod +x cloudflared\n",
        "\n",
        "import os\n",
        "import re\n",
        "import time\n",
        "import subprocess\n",
        "import threading\n",
        "from google.colab import drive\n",
        "\n",
        "print(\"📌 Paso 1: Conectando a Google Drive...\")\n",
        "if not os.path.exists('/content/drive'):\n",
        "    drive.mount('/content/drive')\n",
        "\n",
        "DB_PATH = '/content/vehiculos.db'\n",
        "\n",
        "print(\"\\n📌 Paso 2: Verificando base de datos...\")\n",
        "if not os.path.exists(DB_PATH):\n",
        "    archivo_tar = None\n",
        "    for root, dirs, files in os.walk('/content/drive/MyDrive'):\n",
        "        if 'vehiculos.db.tar.gz' in files:\n",
        "            archivo_tar = os.path.join(root, 'vehiculos.db.tar.gz')\n",
        "            break\n",
        "\n",
        "    if archivo_tar:\n",
        "        print(f\"   Descomprimiendo base de datos en segundo plano...\")\n",
        "        !tar -xf \"{archivo_tar}\" -C /content/\n",
        "        print(\"   ¡Descompresión completada!\")\n",
        "\n",
        "print(\"\\n📌 Paso 3: Sincronizando repositorio AutoFake...\")\n",
        "!git clone https://github.com/matidmax-dot/AutoFake.git /content/AutoFake 2>/dev/null || (cd /content/AutoFake && git pull)\n",
        "%cd /content/AutoFake\n",
        "\n",
        "print(\"\\n📌 Paso 4: Lanzando Servidor FastAPI & Cloudflare Tunnel...\")\n",
        "def run_uvicorn():\n",
        "    import uvicorn\n",
        "    uvicorn.run(\"main:app\", host=\"127.0.0.1\", port=8000, log_level=\"error\")\n",
        "\n",
        "threading.Thread(target=run_uvicorn, daemon=True).start()\n",
        "time.sleep(2)\n",
        "\n",
        "# Capturar y mostrar la URL de Cloudflare Tunnel de forma destacada\n",
        "proc = subprocess.Popen(['./cloudflared', 'tunnel', '--url', 'http://127.0.0.1:8000'], stderr=subprocess.PIPE, text=True)\n",
        "\n",
        "for line in iter(proc.stderr.readline, ''):\n",
        "    match = re.search(r'https://[a-zA-Z0-9\-]+\.trycloudflare\.com', line)\n",
        "    if match:\n",
        "        url = match.group(0)\n",
        "        print(\"\\n============================================================\")\n",
        "        print(\"🚀 ¡TU APLICACIÓN ESTÁ LISTA!\")\n",
        "        print(\"============================================================\")\n",
        "        print(f\"👉  {url}  👈\")\n",
        "        print(\"============================================================\\n\")\n",
        "        break\n",
        "\n",
        "# Mantener el proceso en ejecución\n",
        "proc.wait()\n"
      ]
    }
  ]
